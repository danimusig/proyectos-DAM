<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/etCod"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:ems="10"
        android:hint="@string/ingrese_el_codigo_del_producto"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etDesc" />

    <EditText
        android:id="@+id/etDesc"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:ems="10"
        android:hint="@string/ingrese_la_descripcion"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etCod" />

    <EditText
        android:id="@+id/etPrecio"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:ems="10"
        android:hint="@string/ingrese_el_precio"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etDesc"
        app:layout_constraintBottom_toTopOf="@id/btAlta" />

    <Button
        android:id="@+id/btAlta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alta"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/etPrecio"
        app:layout_constraintStart_toStartOf="@id/etPrecio"
        app:layout_constraintEnd_toEndOf="@id/etPrecio"/>

    <Button
        android:id="@+id/btConsultaCod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/consulta_por_codigo"
        android:layout_marginTop="10dp"

        app:layout_constraintTop_toBottomOf="@id/btAlta"
        app:layout_constraintStart_toStartOf="@id/btAlta"
        app:layout_constraintEnd_toEndOf="@id/btAlta"/>

    <Button
        android:id="@+id/btConsultaDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/consulta_por_descripcion"
        android:layout_marginTop="10dp"

        app:layout_constraintTop_toBottomOf="@id/btConsultaCod"
        app:layout_constraintStart_toStartOf="@id/btConsultaCod"
        app:layout_constraintEnd_toEndOf="@id/btConsultaCod"/>

    <Button
        android:id="@+id/btBajaCod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/baja_por_codigo"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btConsultaDesc"
        app:layout_constraintStart_toStartOf="@id/btConsultaDesc"
        app:layout_constraintEnd_toEndOf="@id/btConsultaDesc" />

    <Button
        android:id="@+id/btMod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modificacion"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btBajaCod"
        app:layout_constraintStart_toStartOf="@id/btBajaCod"
        app:layout_constraintEnd_toEndOf="@id/btBajaCod" />

</androidx.constraintlayout.widget.ConstraintLayout>