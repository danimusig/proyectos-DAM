<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddContact"
    android:background="@color/cardview_dark_background">

    <TextView
        android:id="@+id/tvTitleEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editar_contacto"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@id/etEditNombre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etEditNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/nombre"
        android:inputType="text"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:layout_marginTop="100dp"
        app:layout_constraintBottom_toTopOf="@id/etEditPhone"
        app:layout_constraintEnd_toEndOf="@id/tvTitleEdit"
        app:layout_constraintStart_toStartOf="@id/tvTitleEdit"
        app:layout_constraintTop_toBottomOf="@id/tvTitleEdit" />


    <EditText
        android:id="@+id/etEditPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/telefono"
        android:inputType="phone"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:layout_marginVertical="40dp"
        app:layout_constraintBottom_toTopOf="@id/etEditEmail"
        app:layout_constraintEnd_toEndOf="@id/etEditNombre"
        app:layout_constraintStart_toStartOf="@id/etEditNombre"
        app:layout_constraintTop_toBottomOf="@id/etEditNombre" />

    <EditText
        android:id="@+id/etEditEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/etEditPhone"
        app:layout_constraintStart_toStartOf="@id/etEditPhone"
        app:layout_constraintTop_toBottomOf="@id/etEditPhone" />

    <Button
        android:id="@+id/btVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        app:layout_constraintVertical_chainStyle="spread_inside"
        android:layout_marginVertical="80dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/etEditEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btGuardarCambios"/>

    <Button
        android:id="@+id/btGuardarCambios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar\n cambios"
        android:layout_marginVertical="80dp"
        app:layout_constraintTop_toBottomOf="@id/etEditEmail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btVolver"/>

</androidx.constraintlayout.widget.ConstraintLayout>